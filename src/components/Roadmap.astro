---
import { phases } from "@/data/roadmap";
---

<section id="roadmap" class="mx-auto w-full max-w-5xl px-4 py-12 sm:px-6 sm:py-16">
  <div class="rule mb-8"></div>

  <p class="text-[0.65rem] tracking-[0.22em] text-accent uppercase">execution order</p>
  <h2 class="mt-3 font-display text-2xl font-bold tracking-tight sm:text-4xl">Run it in this order.</h2>

  <ol class="mt-8 space-y-4">
    {
      phases.map((p) => (
        <li
          class:list={[
            "border bg-card/60 p-4 sm:p-5",
            p.status === "active" ? "border-primary/60" : "border-border",
          ]}
        >
          <div class="flex flex-wrap items-center gap-3">
            <span class="text-xs font-bold tracking-[0.2em] text-muted-foreground">{p.id}</span>
            <h3 class="font-display text-base font-bold sm:text-lg">{p.label}</h3>
            <span
              class:list={[
                "ml-auto border px-2 py-0.5 text-[0.6rem] tracking-[0.18em] uppercase",
                p.status === "active"
                  ? "border-primary/50 bg-primary/10 text-primary"
                  : "border-border text-muted-foreground",
              ]}
            >
              {p.status === "active" ? "in progress" : "queued"}
            </span>
          </div>
          <ul class="mt-3 space-y-1.5">
            {p.lines.map((l) => (
              <li class="flex gap-2 text-sm leading-relaxed text-muted-foreground">
                <span class="text-primary">&gt;</span>
                <span>{l}</span>
              </li>
            ))}
          </ul>
        </li>
      ))
    }
  </ol>
</section>
