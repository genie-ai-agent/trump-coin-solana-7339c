---
const reads = [
  {
    k: "trumped",
    v: "What happened to people: a knock, a van, a hearing nobody told them about. Past tense, done to you.",
  },
  {
    k: "the T",
    v: "A card term. Trumping a trick means you take it back. The T on the end is the turn, not the loss.",
  },
  {
    k: "$TRUMPT",
    v: "A parody ticker that reads as a verb. Every dollar of it funds the side doing the fighting back.",
  },
];
---

<section id="name" class="mx-auto w-full max-w-5xl px-4 py-12 sm:px-6 sm:py-16">
  <div class="rule mb-8"></div>
  <p class="text-[0.65rem] tracking-[0.22em] text-primary uppercase">the name</p>
  <h2 class="mt-3 font-display text-2xl font-bold tracking-tight sm:text-4xl">
    TrumpT, three ways<span class="cursor"></span>
  </h2>
  <p class="mt-4 max-w-2xl text-sm leading-relaxed text-muted-foreground">
    The name does the argument for us. It's his word, aimed the other direction.
  </p>

  <dl class="mt-8 grid gap-px border border-border bg-border sm:grid-cols-3">
    {
      reads.map((r) => (
        <div class="bg-card px-4 py-5">
          <dt class="font-display text-lg font-bold text-accent">{r.k}</dt>
          <dd class="mt-2 text-sm leading-relaxed text-muted-foreground">{r.v}</dd>
        </div>
      ))
    }
  </dl>

  <p class="mt-6 max-w-2xl text-[0.7rem] leading-relaxed text-muted-foreground">
    Parody and commentary, not endorsement. No affiliation with Donald Trump or any Trump-branded
    token. A name this close to an existing mark invites a letter, so run it past trademark counsel
    before the mint — and keep the alternate on the shelf.
  </p>
</section>
